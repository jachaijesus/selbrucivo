# Selbrucivo local environment example
#
# Copy this file to .env only when a local override is needed.
# Do not place secrets, passwords, provider credentials, OAuth codes,
# access tokens, refresh tokens, or library-card data in client env files.

# Enables the mocked Connected Library Accounts prototype in production builds.
# The prototype is automatically available during Vite development.
# This is not a secret and must be either "true" or omitted/blank.
VITE_ENABLE_LIBRARY_ACCOUNT_PROTOTYPE=
